.param case=0
.param PROC_ON=0
.param MM_ON=0
Vcc dd 0 dc 2.0
XQ1 c1 b1 0 NPN_HV AREA=1
V1 dd c1 dc 0
I1 0 b1 dc 2.72042578847527e-07 ac 1
XQ2 c2 b2 0 NPN_HV AREA=1

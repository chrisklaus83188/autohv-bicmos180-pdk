.title verify PHI_5V0
.include "../../../autohv_bicmos180_case.lib"
.include "../cells.lib"
.param case=0
Vd v 0 5.0
Vi i 0 PULSE(0 5.0 20n 0.02n 0.02n 80n 400n)
X1 i o v 0 PHI_5V0
CL o 0 5f
.control
option temp=27
tran 0.02n 220n
meas tran tmd trig v(o) val=2.5 rise=1 td=19n targ v(o) val=2.5 fall=1 td=19n
meas tran tmp find v(o) at=190n
meas tran lo find v(o) at=10n
meas tran hi find v(o) at=30n
echo "RES tmd=$&tmd tmp=$&tmp lo=$&lo hi=$&hi"
.endc
.end

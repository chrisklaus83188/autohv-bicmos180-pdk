* ==========================================================================
* RAIL-TO-RAIL INPUT  (complementary pairs summed in a folded cascode)
* ==========================================================================

.subckt CMP_RR_5V0 inp inn out vdd vss ibp_5uA EN params: IREF=5u FIN=1
* --- bias generation ---
Xrbn  ibp_5uA  ibp_5uA  vssa vss NMOS50 W=10u L=1u M=1            ; NMOS diode ref (carries IREF)
Xmir  pmd ibp_5uA  vssa vss NMOS50 W=10u L=1u M=1            ; mirror IREF up
Xrbp  pmd pmd vdda vdd PMOS50 W=20u L=1u M=1            ; PMOS diode -> vbp = pmd
Xvc1  k   k   vdda vdd PMOS50 W=20u L=1u M=1            ; vcp = VDD - 2*|Vsg| (VDD-referenced
Xvc2  vcp vcp k   vdd PMOS50 W=20u L=1u M=1            ;   cascode bias: x tracks the rail so
Xisk  vcp ibp_5uA  vssa vss NMOS50 W=10u L=1u M=1            ;   the fold sources keep Vds at brownout)
* --- rail-to-rail folded-cascode input stage ---
Xmtn  sn  ibp_5uA  vssa vss NMOS50 W=20u L=1u M=1            ; NMOS pair tail (~2*IREF)
Xn1   x   inp sn  vss NMOS50 W={40u*FIN} L={1u*FIN} M=1
Xn2   y   inn sn  vss NMOS50 W={40u*FIN} L={1u*FIN} M=1
Xmtp  sp  pmd vdda vdd PMOS50 W=40u L=1u M=1            ; PMOS pair tail (~2*IREF)
Xp1   a   inp sp  vdd PMOS50 W={80u*FIN} L={1u*FIN} M=1
Xp2   b   inn sp  vdd PMOS50 W={80u*FIN} L={1u*FIN} M=1
Xf1   x   pmd vdda vdd PMOS50 W=60u L=1u M=1            ; top fold sources
Xf2   y   pmd vdda vdd PMOS50 W=60u L=1u M=1
Xcp1  a   vcp x   vdd PMOS50 W=40u L=1u M=1            ; PMOS cascodes x->a, y->b
Xcp2  b   vcp y   vdd PMOS50 W=40u L=1u M=1
Xmm1  a   a   vssa vss NMOS50 W={20u*FIN} L={1u*FIN} M=1 ; bottom mirror diode (a)
Xmm2  b   a   vssa vss NMOS50 W={20u*FIN} L={1u*FIN} M=1 ; mirror out -> stage-1 out = b
* --- stage 2: common-source gain + current-source load ---
Xs2n  o2  b   vssa vss NMOS50 W=40u L=1u M=1
Xs2p  o2  pmd vdda vdd PMOS50 W=40u L=1u M=1
* --- stage 3: CMOS inverter (rail-to-rail digital out) ---
Xbp   out o2  vdda vdd PMOS50 W=20u L=0.5u M=1
Xbn   out o2  vssa vss NMOS50 W=10u L=0.5u M=1
* --- enable: 2-inverter buffer (always-on rails) + power-gating switches ---
* EN=1 normal; EN=0 disables: header/footer open -> core isolated (zero Iq), OUT forced low.
Xei1p ENB   EN    vdd vdd PMOS50 W=4u L=0.5u M=1            ; INV1: ENB = /EN
Xei1n ENB   EN    vss vss NMOS50 W=2u L=0.5u M=1
Xei2p ENbuf ENB   vdd vdd PMOS50 W=4u L=0.5u M=1            ; INV2: ENbuf = EN (buffered)
Xei2n ENbuf ENB   vss vss NMOS50 W=2u L=0.5u M=1
Xenhdr vdda ENB   vdd vdd PMOS50 W=400u L=0.5u M=1          ; PMOS header (off when EN=0)
Xenftr vssa ENbuf vss vss NMOS50 W=200u L=0.5u M=1          ; NMOS footer (off when EN=0)
Xenpd  out  ENB   vss vss NMOS50 W=20u L=0.5u M=1           ; force OUT low when EN=0
.ends CMP_RR_5V0

.subckt CMP_RR_3V3 inp inn out vdd vss ibp_5uA EN params: IREF=5u FIN=1
* --- bias generation ---
Xrbn  ibp_5uA  ibp_5uA  vssa vss NMOS33 W=10u L=1u M=1            ; NMOS diode ref (carries IREF)
Xmir  pmd ibp_5uA  vssa vss NMOS33 W=10u L=1u M=1            ; mirror IREF up
Xrbp  pmd pmd vdda vdd PMOS33 W=20u L=1u M=1            ; PMOS diode -> vbp = pmd
Xvc1  k   k   vdda vdd PMOS33 W=20u L=1u M=1            ; vcp = VDD - 2*|Vsg| (VDD-referenced
Xvc2  vcp vcp k   vdd PMOS33 W=20u L=1u M=1            ;   cascode bias: x tracks the rail so
Xisk  vcp ibp_5uA  vssa vss NMOS33 W=10u L=1u M=1            ;   the fold sources keep Vds at brownout)
* --- rail-to-rail folded-cascode input stage ---
Xmtn  sn  ibp_5uA  vssa vss NMOS33 W=20u L=1u M=1            ; NMOS pair tail (~2*IREF)
Xn1   x   inp sn  vss NMOS33 W={40u*FIN} L={1u*FIN} M=1
Xn2   y   inn sn  vss NMOS33 W={40u*FIN} L={1u*FIN} M=1
Xmtp  sp  pmd vdda vdd PMOS33 W=40u L=1u M=1            ; PMOS pair tail (~2*IREF)
Xp1   a   inp sp  vdd PMOS33 W={80u*FIN} L={1u*FIN} M=1
Xp2   b   inn sp  vdd PMOS33 W={80u*FIN} L={1u*FIN} M=1
Xf1   x   pmd vdda vdd PMOS33 W=60u L=1u M=1            ; top fold sources
Xf2   y   pmd vdda vdd PMOS33 W=60u L=1u M=1
Xcp1  a   vcp x   vdd PMOS33 W=40u L=1u M=1            ; PMOS cascodes x->a, y->b
Xcp2  b   vcp y   vdd PMOS33 W=40u L=1u M=1
Xmm1  a   a   vssa vss NMOS33 W={20u*FIN} L={1u*FIN} M=1 ; bottom mirror diode (a)
Xmm2  b   a   vssa vss NMOS33 W={20u*FIN} L={1u*FIN} M=1 ; mirror out -> stage-1 out = b
* --- stage 2: common-source gain + current-source load ---
Xs2n  o2  b   vssa vss NMOS33 W=40u L=1u M=1
Xs2p  o2  pmd vdda vdd PMOS33 W=40u L=1u M=1
* --- stage 3: CMOS inverter (rail-to-rail digital out) ---
Xbp   out o2  vdda vdd PMOS33 W=20u L=0.5u M=1
Xbn   out o2  vssa vss NMOS33 W=10u L=0.5u M=1
* --- enable: 2-inverter buffer (always-on rails) + power-gating switches ---
* EN=1 normal; EN=0 disables: header/footer open -> core isolated (zero Iq), OUT forced low.
Xei1p ENB   EN    vdd vdd PMOS33 W=4u L=0.5u M=1            ; INV1: ENB = /EN
Xei1n ENB   EN    vss vss NMOS33 W=2u L=0.5u M=1
Xei2p ENbuf ENB   vdd vdd PMOS33 W=4u L=0.5u M=1            ; INV2: ENbuf = EN (buffered)
Xei2n ENbuf ENB   vss vss NMOS33 W=2u L=0.5u M=1
Xenhdr vdda ENB   vdd vdd PMOS33 W=400u L=0.5u M=1          ; PMOS header (off when EN=0)
Xenftr vssa ENbuf vss vss NMOS33 W=200u L=0.5u M=1          ; NMOS footer (off when EN=0)
Xenpd  out  ENB   vss vss NMOS33 W=20u L=0.5u M=1           ; force OUT low when EN=0
.ends CMP_RR_3V3


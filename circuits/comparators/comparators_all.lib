* ==========================================================================
* comparators_all.lib  -  AutoHV BiCMOS 180  (single consolidated library)
* --------------------------------------------------------------------------
* AUTO-GENERATED by gen_comparators_all.py from the per-cell libraries in
* this directory. Every comparator subckt is collected here under a
* RAIL-SUFFIXED name so they coexist in one file. Bodies are verbatim copies
* (electrically identical) -- edit the per-folder libs and regenerate; do not
* hand-edit this file.
*
* Use:  .include the PDK model lib AND this file, then instance by name:
*   .include "<...>/autohv_bicmos180_case.lib"
*   .include "comparators_all.lib"
*   X1 inp inn out vdd 0 ibp_5uA vdd CMP_RR_5V0 IREF=5u FIN=1   (last net EN, high=enabled)
*   Ib vdd ibp_5uA 5u
*
* Ports (all cells):  inp inn out vdd vss <bias> EN   (vdd/vss only).
* Enable: EN active-high. EN=0 -> core power-gated (zero static Iq) and OUT forced low.
* Bias pin encodes expected current+sense: ibp_5uA = source 5 uA IN (CMP_NIN,
*   CMP_RR; diode-tied NMOS, from vdd); ibn_5uA = sink 5 uA OUT (CMP_PIN;
*   diode-tied PMOS, to vss). Drive that pin with a matching current source.
* Polarity        :  OUT high when V(inp) > V(inn).
* Naming          :  CMP_<type>_<rail>  -  type NIN/PIN (general-purpose,
*                    NMOS-/PMOS-input) or RR (rail-to-rail input);
*                    rail 5V0 / 3V3 / 1V8.
* Knobs/specs/sign-off: README.md, general_purpose/DESIGN_NOTES.md, folder READMEs.
*
* Contents (9 subckts):
*   CMP_NIN_5V0
*   CMP_PIN_5V0
*   CMP_NIN_3V3
*   CMP_PIN_3V3
*   CMP_NIN_1V8
*   CMP_PIN_1V8
*   CMP_RR_5V0
*   CMP_RR_3V3
*   CMP_RR_1V8
* ==========================================================================


* ==========================================================================
* GENERAL-PURPOSE  (two-stage; NMOS-input = high CM / PMOS-input = low CM)
* ==========================================================================

.subckt CMP_NIN_5V0 inp inn out vdd vss ibp_5uA EN params: IREF=5u WSCALE=1 WIN=40u LIN=2u LANA=2u FIN=1 HYSK=0
* --- bias mirror ---
Xmb   ibp_5uA  ibp_5uA  vssa vss NMOS50 W={10u*WSCALE} L={LANA} M=1   ; diode ref (carries IREF)
* --- stage 1: NMOS pair, PMOS mirror load (both scaled by FIN for offset) ---
Xtail tail ibp_5uA vssa vss NMOS50 W={10u*WSCALE} L={LANA} M=2   ; Itail = 2*IREF
Xm1   n1  inp tail vss NMOS50 W={WIN*FIN} L={LIN*FIN} M=1
Xm2   n2  inn tail vss NMOS50 W={WIN*FIN} L={LIN*FIN} M=1
Xm3   n1  n1  vdda vdd  PMOS50 W={20u*WSCALE*FIN} L={LANA*FIN} M=1  ; mirror in (diode)
Xm4   n2  n1  vdda vdd  PMOS50 W={20u*WSCALE*FIN} L={LANA*FIN} M=1  ; mirror out -> stage1 out = n2
* --- optional steered-current hysteresis ---
.if (HYSK > 0)
Xhtail sh ibp_5uA vssa vss NMOS50 W={10u*WSCALE*HYSK} L={LANA} M=1
Xmha   n1  out sh vss NMOS50 W={10u*WSCALE} L=0.5u M=1
Xmhb   n2  o2  sh vss NMOS50 W={10u*WSCALE} L=0.5u M=1
.endif
* --- stage 2: PMOS common-source + NMOS current-source load ---
Xm5   o2  n2  vdda vdd  PMOS50 W={80u*WSCALE} L={LANA} M=1  ; 4x mirror unit -> ~4*IREF
Xm6   o2  ibp_5uA  vssa vss  NMOS50 W={10u*WSCALE} L={LANA} M=4  ; sink 4*IREF
* --- stage 3: CMOS output inverter (rail-to-rail) ---
Xm7   out o2  vdda vdd  PMOS50 W={20u*WSCALE} L=0.5u M=1
Xm8   out o2  vssa vss  NMOS50 W={10u*WSCALE} L=0.5u M=1
* --- enable: 2-inverter buffer (always-on rails) + power-gating switches ---
* EN=1 normal; EN=0 disables: header/footer open -> core isolated (zero Iq), OUT forced low.
Xei1p ENB   EN    vdd vdd PMOS50 W=4u L=0.5u M=1            ; INV1: ENB = /EN
Xei1n ENB   EN    vss vss NMOS50 W=2u L=0.5u M=1
Xei2p ENbuf ENB   vdd vdd PMOS50 W=4u L=0.5u M=1            ; INV2: ENbuf = EN (buffered)
Xei2n ENbuf ENB   vss vss NMOS50 W=2u L=0.5u M=1
Xenhdr vdda ENB   vdd vdd PMOS50 W=400u L=0.5u M=1          ; PMOS header (off when EN=0)
Xenftr vssa ENbuf vss vss NMOS50 W=200u L=0.5u M=1          ; NMOS footer (off when EN=0)
Xenpd  out  ENB   vss vss NMOS50 W=20u L=0.5u M=1           ; force OUT low when EN=0
.ends CMP_NIN_5V0

.subckt CMP_PIN_5V0 inp inn out vdd vss ibn_5uA EN params: IREF=5u WSCALE=1 WIN=80u LIN=2u LANA=2u FIN=1 HYSK=0
* --- bias mirror (PMOS diode; ref current pulled from ibn_5uA down toward vss) ---
Xmb   ibn_5uA  ibn_5uA  vdda vdd  PMOS50 W={20u*WSCALE} L={LANA} M=1  ; diode ref (carries IREF)
* --- stage 1: PMOS pair, NMOS mirror load (both scaled by FIN for offset) ---
Xtail tail ibn_5uA vdda vdd  PMOS50 W={20u*WSCALE} L={LANA} M=2  ; Itail = 2*IREF
Xm1   n1  inp tail vdd PMOS50 W={WIN*FIN} L={LIN*FIN} M=1
Xm2   n2  inn tail vdd PMOS50 W={WIN*FIN} L={LIN*FIN} M=1
Xm3   n1  n1  vssa vss  NMOS50 W={10u*WSCALE*FIN} L={LANA*FIN} M=1  ; mirror in (diode)
Xm4   n2  n1  vssa vss  NMOS50 W={10u*WSCALE*FIN} L={LANA*FIN} M=1  ; mirror out -> stage1 out = n2
* --- optional steered-current hysteresis ---
.if (HYSK > 0)
Xhtail sh ibn_5uA vdda vdd PMOS50 W={20u*WSCALE*HYSK} L={LANA} M=1
Xmha   n1  out sh vdd PMOS50 W={20u*WSCALE} L=0.5u M=1
Xmhb   n2  o2  sh vdd PMOS50 W={20u*WSCALE} L=0.5u M=1
.endif
* --- stage 2: NMOS common-source + PMOS current-source load ---
Xm5   o2  n2  vssa vss  NMOS50 W={40u*WSCALE} L={LANA} M=1  ; 4x mirror unit -> ~4*IREF
Xm6   o2  ibn_5uA  vdda vdd  PMOS50 W={20u*WSCALE} L={LANA} M=4  ; source 4*IREF
* --- stage 3: CMOS output inverter (rail-to-rail) ---
Xm7   out o2  vdda vdd  PMOS50 W={20u*WSCALE} L=0.5u M=1
Xm8   out o2  vssa vss  NMOS50 W={10u*WSCALE} L=0.5u M=1
* --- enable: 2-inverter buffer (always-on rails) + power-gating switches ---
* EN=1 normal; EN=0 disables: header/footer open -> core isolated (zero Iq), OUT forced low.
Xei1p ENB   EN    vdd vdd PMOS50 W=4u L=0.5u M=1            ; INV1: ENB = /EN
Xei1n ENB   EN    vss vss NMOS50 W=2u L=0.5u M=1
Xei2p ENbuf ENB   vdd vdd PMOS50 W=4u L=0.5u M=1            ; INV2: ENbuf = EN (buffered)
Xei2n ENbuf ENB   vss vss NMOS50 W=2u L=0.5u M=1
Xenhdr vdda ENB   vdd vdd PMOS50 W=400u L=0.5u M=1          ; PMOS header (off when EN=0)
Xenftr vssa ENbuf vss vss NMOS50 W=200u L=0.5u M=1          ; NMOS footer (off when EN=0)
Xenpd  out  ENB   vss vss NMOS50 W=20u L=0.5u M=1           ; force OUT low when EN=0
.ends CMP_PIN_5V0


Xei2p ENbuf ENB   vdd vdd PMOS18 W=4u L=0.5u M=1            ; INV2: ENbuf = EN (buffered)
Xei2n ENbuf ENB   vss vss NMOS18 W=2u L=0.5u M=1
Xenhdr vdda ENB   vdd vdd PMOS18 W=400u L=0.5u M=1          ; PMOS header (off when EN=0)

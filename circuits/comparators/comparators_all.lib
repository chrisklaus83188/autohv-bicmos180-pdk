Xei2p ENbuf ENB   vdd vdd PMOS18 W=4u L=0.5u M=1            ; ENbuf = EN (buffered)
Xei2n ENbuf ENB   vss vss NMOS18 W=2u L=0.5u M=1
Xser  ibg_n ENbuf ibp_5uA vss NMOS18 W=4u L=0.5u M=1        ; series: bias pin -> NMOS mirror gate
Xshn  ibg_n ENB   vss     vss NMOS18 W=4u L=0.5u M=1        ; gate-short: ibg_n -> vss (EN=0)
Xshp  pmd   ENbuf vdd     vdd PMOS18 W=4u L=0.5u M=1        ; gate-short: pmd -> vdd (PMOS side off)
Xsho2 o2    ENB   vss     vss NMOS18 W=4u L=0.5u M=1         ; clamp o2 -> vss (OUT high when EN=0)

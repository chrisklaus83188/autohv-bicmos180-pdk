* ==========================================================================
* RAIL-TO-RAIL INPUT  (complementary pairs summed in a folded cascode)
* ==========================================================================

.subckt CMP_RR_5V0 inp inn out vdd vss ibp_5uA EN params: IREF=5u FIN=1
* --- bias generation ---
Xrbn  ibg_n  ibg_n  vss vss NMOS50 W=10u L=1u M=1            ; NMOS diode ref (carries IREF)
Xmir  pmd ibg_n  vss vss NMOS50 W=10u L=1u M=1            ; mirror IREF up
Xrbp  pmd pmd vdd vdd PMOS50 W=20u L=1u M=1            ; PMOS diode -> vbp = pmd
Xvc1  k   k   vdd vdd PMOS50 W=20u L=1u M=1            ; vcp = VDD - 2*|Vsg| (VDD-referenced
Xvc2  vcp vcp k   vdd PMOS50 W=20u L=1u M=1            ;   cascode bias: x tracks the rail so
Xisk  vcp ibg_n  vss vss NMOS50 W=10u L=1u M=1            ;   the fold sources keep Vds at brownout)
* --- rail-to-rail folded-cascode input stage ---
Xmtn  sn  ibg_n  vss vss NMOS50 W=20u L=1u M=1            ; NMOS pair tail (~2*IREF)
Xn1   x   inp sn  vss NMOS50 W={40u*FIN} L={1u*FIN} M=1
Xn2   y   inn sn  vss NMOS50 W={40u*FIN} L={1u*FIN} M=1
Xmtp  sp  pmd vdd vdd PMOS50 W=40u L=1u M=1            ; PMOS pair tail (~2*IREF)
Xp1   a   inp sp  vdd PMOS50 W={80u*FIN} L={1u*FIN} M=1
Xp2   b   inn sp  vdd PMOS50 W={80u*FIN} L={1u*FIN} M=1
Xf1   x   pmd vdd vdd PMOS50 W=60u L=1u M=1            ; top fold sources
Xf2   y   pmd vdd vdd PMOS50 W=60u L=1u M=1
Xcp1  a   vcp x   vdd PMOS50 W=40u L=1u M=1            ; PMOS cascodes x->a, y->b
Xcp2  b   vcp y   vdd PMOS50 W=40u L=1u M=1
Xmm1  a   a   vss vss NMOS50 W={20u*FIN} L={1u*FIN} M=1 ; bottom mirror diode (a)
Xmm2  b   a   vss vss NMOS50 W={20u*FIN} L={1u*FIN} M=1 ; mirror out -> stage-1 out = b
* --- stage 2: common-source gain + current-source load ---
Xs2n  o2  b   vss vss NMOS50 W=40u L=1u M=1
Xs2p  o2  pmd vdd vdd PMOS50 W=40u L=1u M=1
* --- stage 3: CMOS inverter (rail-to-rail digital out) ---
Xbp   out o2  vdd vdd PMOS50 W=20u L=0.5u M=1
Xbn   out o2  vss vss NMOS50 W=10u L=0.5u M=1
* --- enable / bias-shutdown disable (small switches; core on true rails) ---
Xei1p ENB   EN    vdd vdd PMOS50 W=4u L=0.5u M=1            ; ENB = /EN
Xei1n ENB   EN    vss vss NMOS50 W=2u L=0.5u M=1
Xei2p ENbuf ENB   vdd vdd PMOS50 W=4u L=0.5u M=1            ; ENbuf = EN (buffered)
Xei2n ENbuf ENB   vss vss NMOS50 W=2u L=0.5u M=1
Xser  ibg_n ENbuf ibp_5uA vss NMOS50 W=4u L=0.5u M=1        ; series: bias pin -> NMOS mirror gate
Xshn  ibg_n ENB   vss     vss NMOS50 W=4u L=0.5u M=1        ; gate-short: ibg_n -> vss (EN=0)
Xshp  pmd   ENbuf vdd     vdd PMOS50 W=4u L=0.5u M=1        ; gate-short: pmd -> vdd (PMOS side off)
Xsho2 o2    ENB   vss     vss NMOS50 W=4u L=0.5u M=1         ; clamp o2 -> vss (OUT high when EN=0)
.ends CMP_RR_5V0

.subckt CMP_RR_3V3 inp inn out vdd vss ibp_5uA EN params: IREF=5u FIN=1
* --- bias generation ---
Xrbn  ibg_n  ibg_n  vss vss NMOS33 W=10u L=1u M=1            ; NMOS diode ref (carries IREF)
Xmir  pmd ibg_n  vss vss NMOS33 W=10u L=1u M=1            ; mirror IREF up
Xrbp  pmd pmd vdd vdd PMOS33 W=20u L=1u M=1            ; PMOS diode -> vbp = pmd
Xvc1  k   k   vdd vdd PMOS33 W=20u L=1u M=1            ; vcp = VDD - 2*|Vsg| (VDD-referenced
Xvc2  vcp vcp k   vdd PMOS33 W=20u L=1u M=1            ;   cascode bias: x tracks the rail so
Xisk  vcp ibg_n  vss vss NMOS33 W=10u L=1u M=1            ;   the fold sources keep Vds at brownout)
* --- rail-to-rail folded-cascode input stage ---
Xmtn  sn  ibg_n  vss vss NMOS33 W=20u L=1u M=1            ; NMOS pair tail (~2*IREF)
Xn1   x   inp sn  vss NMOS33 W={40u*FIN} L={1u*FIN} M=1
Xn2   y   inn sn  vss NMOS33 W={40u*FIN} L={1u*FIN} M=1
Xmtp  sp  pmd vdd vdd PMOS33 W=40u L=1u M=1            ; PMOS pair tail (~2*IREF)
Xp1   a   inp sp  vdd PMOS33 W={80u*FIN} L={1u*FIN} M=1
Xp2   b   inn sp  vdd PMOS33 W={80u*FIN} L={1u*FIN} M=1
Xf1   x   pmd vdd vdd PMOS33 W=60u L=1u M=1            ; top fold sources
Xf2   y   pmd vdd vdd PMOS33 W=60u L=1u M=1
Xcp1  a   vcp x   vdd PMOS33 W=40u L=1u M=1            ; PMOS cascodes x->a, y->b
Xcp2  b   vcp y   vdd PMOS33 W=40u L=1u M=1
Xmm1  a   a   vss vss NMOS33 W={20u*FIN} L={1u*FIN} M=1 ; bottom mirror diode (a)
Xmm2  b   a   vss vss NMOS33 W={20u*FIN} L={1u*FIN} M=1 ; mirror out -> stage-1 out = b
* --- stage 2: common-source gain + current-source load ---
Xs2n  o2  b   vss vss NMOS33 W=40u L=1u M=1
Xs2p  o2  pmd vdd vdd PMOS33 W=40u L=1u M=1
* --- stage 3: CMOS inverter (rail-to-rail digital out) ---
Xbp   out o2  vdd vdd PMOS33 W=20u L=0.5u M=1
Xbn   out o2  vss vss NMOS33 W=10u L=0.5u M=1
* --- enable / bias-shutdown disable (small switches; core on true rails) ---
Xei1p ENB   EN    vdd vdd PMOS33 W=4u L=0.5u M=1            ; ENB = /EN
Xei1n ENB   EN    vss vss NMOS33 W=2u L=0.5u M=1
Xei2p ENbuf ENB   vdd vdd PMOS33 W=4u L=0.5u M=1            ; ENbuf = EN (buffered)
Xei2n ENbuf ENB   vss vss NMOS33 W=2u L=0.5u M=1
Xser  ibg_n ENbuf ibp_5uA vss NMOS33 W=4u L=0.5u M=1        ; series: bias pin -> NMOS mirror gate
Xshn  ibg_n ENB   vss     vss NMOS33 W=4u L=0.5u M=1        ; gate-short: ibg_n -> vss (EN=0)
Xshp  pmd   ENbuf vdd     vdd PMOS33 W=4u L=0.5u M=1        ; gate-short: pmd -> vdd (PMOS side off)
Xsho2 o2    ENB   vss     vss NMOS33 W=4u L=0.5u M=1         ; clamp o2 -> vss (OUT high when EN=0)
.ends CMP_RR_3V3

.subckt CMP_RR_1V8 inp inn out vdd vss ibp_5uA EN params: IREF=5u FIN=1
* --- bias generation ---
Xrbn  ibg_n  ibg_n  vss vss NMOS18 W=10u L=1u M=1            ; NMOS diode ref (carries IREF)
Xmir  pmd ibg_n  vss vss NMOS18 W=10u L=1u M=1            ; mirror IREF up
